                <_dataType>Expression</_dataType>
                <_expression>@"
{
    ""input_spec"": {
        ""style"": 1,
        ""prompt"": ""Intelligent automation provider ABBYY recently announced its relocation of corporate headquarters to Austin, Texas, reflecting a strategic shift aimed at transforming the automation industry and improving internal efficiency. The move also involves expanding key departments and appointing new senior leadership, underscoring ABBYY's commitment to enhancing collaboration and innovation. Additionally, the company highlighted plans to grow and innovate globally, including expanding their development centers in India and Hungary. Despite shifting their primary base to Austin, ABBYY's original headquarters in Milpitas, California, will remain active."",
        ""target_image_weight"": 0.1,
        ""width"": 1024,
        ""height"": 1024
    }
}";
</_expression>
